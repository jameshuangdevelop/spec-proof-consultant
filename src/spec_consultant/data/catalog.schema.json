{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-consultant.local/catalog.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "scenarios"],
  "properties": {
    "version": {"const": "1"},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url", "checked"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "checked": {"type": "string", "format": "date"}
      }
    },
    "alternative": {
      "type": "object", "additionalProperties": false, "required": ["tool", "reason"],
      "properties": {"tool": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "kind", "property", "prerequisites", "acceptance"],
      "properties": {
        "key": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["evidence-gathering", "implementation"]},
        "property": {"$ref": "#/$defs/text"},
        "prerequisites": {"$ref": "#/$defs/texts"},
        "acceptance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "title", "languages", "patterns", "goals", "goal_tags", "constraints", "hard_exclusions", "questions", "tool", "method", "alternatives", "assurance", "does_not_establish", "tool_version", "sources", "examples", "evidence_status", "work_items"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "title": {"$ref": "#/$defs/text"},
        "languages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "goals": {"$ref": "#/$defs/texts"},
        "goal_tags": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["memory-safety", "arithmetic", "functional-correctness", "state-invariants", "progress", "verified-source"]}
        },
        "constraints": {"$ref": "#/$defs/texts"},
        "hard_exclusions": {"$ref": "#/$defs/texts"},
        "questions": {"$ref": "#/$defs/texts"},
        "tool": {"enum": ["Kani", "Verus", "CBMC", "TLC", "Dafny"]},
        "method": {"enum": ["bounded-model-checking", "deductive-verification", "explicit-state-model-checking", "verified-source-codegen"]},
        "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}},
        "assurance": {"$ref": "#/$defs/text"},
        "does_not_establish": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "tool_version": {"$ref": "#/$defs/text"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "examples": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["url", "scope"],
            "properties": {"url": {"type": "string", "pattern": "^https://"}, "scope": {"$ref": "#/$defs/text"}}
          }
        },
        "evidence_status": {"enum": ["documented", "fixture-reproduced", "multi-case-supported"]},
        "work_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/template"}}
      }
    }
  }
}
